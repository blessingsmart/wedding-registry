# ==========================================
# Alwaysdata MySQL Database Configuration
# ==========================================
# Copy these values into your Render.com Environment tab

DB_HOST=mysql-youraccount.alwaysdata.net
DB_PORT=3306
DB_NAME=youraccount_wedding
DB_USER=youraccount_admin
DB_PASSWORD=your_database_password

# Set to true only if Alwaysdata enforces SSL (optional, default is false)
DB_SSL=false
